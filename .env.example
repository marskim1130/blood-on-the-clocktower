# Compose 部署域名，不含 https://、端口和路径。
CLOCKTOWER_DOMAIN=clocktower.example.com
# 每次发布使用新标签，保留旧镜像以便回滚。
CLOCKTOWER_RELEASE=local

# 必填。使用 openssl rand -hex 32 生成，跨重启保持不变；不要提交真实密钥。
CLOCKTOWER_CREDENTIAL_KEY=

# Optional Redis persistence. When set, Redis takes precedence over file persistence.
CLOCKTOWER_REDIS_URL=redis://localhost:6379/0
CLOCKTOWER_REDIS_KEY=clocktower

# Optional file persistence directory. Each room is stored as <roomId>.json.
# CLOCKTOWER_SNAPSHOT_PATH=./data/rooms
