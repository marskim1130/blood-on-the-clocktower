{
  "name": "@clocktower/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "build:rn": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/index.bundle --assets-dest dist",
    "dev": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "dev:rn": "taro build --type rn --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clocktower/core": "workspace:*",
    "@react-native-picker/picker": "2.6.1",
    "@react-native/metro-config": "0.73.5",
    "@tarojs/cli": "4.0.0",
    "@tarojs/components": "4.0.0",
    "@tarojs/components-rn": "4.0.0",
    "@tarojs/helper": "4.0.0",
    "@tarojs/plugin-framework-react": "4.0.0",
    "@tarojs/plugin-platform-weapp": "4.0.0",
    "@tarojs/react": "4.0.0",
    "@tarojs/rn-runner": "4.0.0",
    "@tarojs/rn-supporter": "4.0.0",
    "@tarojs/router-rn": "4.0.0",
    "@tarojs/runtime": "4.0.0",
    "@tarojs/runtime-rn": "4.0.0",
    "@tarojs/shared": "4.0.0",
    "@tarojs/taro": "4.0.0",
    "@tarojs/taro-rn": "4.0.0",
    "expo": "50.0.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.73.11",
    "react-native-gesture-handler": "2.14.1",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "3.29.0",
    "react-native-svg": "14.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/plugin-platform-h5": "^4.0.0",
    "@tarojs/webpack5-runner": "4.0.0",
    "@types/react": "^18.3.0",
    "babel-preset-taro": "4.0.0",
    "jsdom": "^29.1.1",
    "metro-react-native-babel-preset": "0.77.0",
    "react-refresh": "^0.18.0",
    "stylelint": "16.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
